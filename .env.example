# Database (used for local non-container development)
# Docker containers use the internal postgres service automatically.
DATABASE_URL=postgresql://trademeup_user:trademeup_pass@localhost:5432/trademeup

# Redis (optional) - caches expensive dashboard count queries.
# The app runs fine without it and simply queries the database directly.
# Docker containers use the internal redis service automatically.
REDIS_URL=redis://localhost:6379/0
# Cache size cap for the Docker redis service; oldest keys are evicted first.
REDIS_MAXMEMORY=256mb

# LLM provider
# For Docker, the easiest zero-config path is host Ollama:
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Optional API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
NEWS_API_KEY=
ALPHA_VANTAGE_KEY=

# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# API Settings
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8050"]

# Model Settings
MODEL_PATH=./models
DEFAULT_TEMPERATURE=0.1
MAX_TOKENS=2000

# Pipeline Phase Settings (enable/disable phases to optimize token usage)
ENABLE_FACT_CHECKING=true
ENABLE_CALIBRATION=true
ENABLE_META_STRATEGY=true
ENABLE_SCENARIOS=true

# Prediction Settings
# Minimum impact score threshold for generating predictions (0.0-1.0)
# Lower values (e.g., 0.3) generate more predictions but may include lower-quality signals
# Default: 0.4 (only high-impact news generates predictions)
MIN_PREDICTION_IMPACT_THRESHOLD=0.4
