{
  "version": "1.0.0",
  "description": "Trading simulation parameters for cost modeling and risk constraints",

  "cost_parameters": {
    "commission": {
      "per_share": 0.005,
      "min_commission": 1.0,
      "description": "Commission charged per share with minimum per trade"
    },
    "spread_bps": {
      "low_volatility": 4.0,
      "medium_volatility": 8.0,
      "high_volatility": 12.0,
      "stressed_volatility": 18.0,
      "description": "Bid-ask spread in basis points by volatility regime"
    },
    "slippage_bps": {
      "normal": 5.0,
      "high_volatility": 9.0,
      "stressed": 15.0,
      "description": "Price slippage in basis points"
    },
    "market_impact_bps": {
      "small_order": 6.0,
      "medium_order": 12.0,
      "large_order": 25.0,
      "volume_threshold_pct": 1.0,
      "description": "Market impact based on order size relative to daily volume"
    },
    "overnight_financing": {
      "long_position_bps_per_day": 1.1,
      "short_position_bps_per_day": 1.4,
      "description": "Overnight financing costs (margin interest) per day in basis points"
    },
    "short_borrow_costs": {
      "easy_to_borrow_annual_pct": 0.5,
      "moderate_borrow_annual_pct": 5.0,
      "hard_to_borrow_annual_pct": 25.0,
      "very_hard_to_borrow_annual_pct": 50.0,
      "description": "Annual short-selling borrow costs as percentage of position value"
    },
    "regulatory_fees": {
      "sec_fee_bps": 0.278,
      "finra_taf_bps": 0.013,
      "description": "SEC Section 31 fees and FINRA Trading Activity Fee"
    }
  },

  "position_constraints": {
    "max_position_size_pct": 10.0,
    "max_sector_concentration_pct": 25.0,
    "max_leverage": 2.0,
    "min_liquidity_usd": 100000,
    "max_daily_volume_participation_pct": 5.0,
    "description": "Position sizing and portfolio-level risk limits"
    },

  "penny_stock_handling": {
    "enabled": true,
    "price_threshold_usd": 1.0,
    "min_valid_price_usd": 0.00001,
    "cost_method": "per_share_only",
    "max_cost_bps_cap": 1000,
    "description": "Special handling for low-priced stocks to prevent unrealistic BPS calculations",
    "ultra_penny_threshold_usd": 0.001,
    "ultra_penny_share_multiplier": 1000,
    "ultra_penny_description": "Ultra-cheap stocks (< $0.001) use 1000x higher share counts to achieve realistic position sizes",
    "methods": {
      "per_share_only": {
        "description": "Use only per-share commission costs, skip BPS-based costs",
        "commission_per_share": 0.005,
        "min_commission": 1.0
      },
      "flat_dollar": {
        "description": "Use flat dollar amounts instead of BPS calculations",
        "total_cost_usd": 5.0
      },
      "capped_bps": {
        "description": "Calculate BPS normally but cap at maximum",
        "max_bps": 1000
      }
    },
    "position_value_targets": {
      "ultra_penny": {
        "min_position_value_usd": 10.0,
        "max_position_value_usd": 100.0,
        "description": "For ultra-pennies (< $0.001), target $10-100 positions"
      },
      "penny": {
        "min_position_value_usd": 50.0,
        "max_position_value_usd": 500.0,
        "description": "For pennies ($0.001-$1.00), target $50-500 positions"
      }
    }
  },

  "decision_thresholds": {
    "min_confidence": 0.55,
    "min_expected_return_pct": 0.75,
    "max_risk_score": 0.65,
    "max_cost_ratio": 0.70,
    "description": "Thresholds for BUY/SELL/HOLD decisions"
  },

  "risk_weights": {
    "model_uncertainty": 0.18,
    "divergence_magnitude": 0.18,
    "volatility_regime": 0.13,
    "liquidity_stress": 0.10,
    "regime_instability": 0.10,
    "transaction_cost": 0.09,
    "market_impact": 0.09,
    "correlation_breakdown": 0.05,
    "position_concentration": 0.05,
    "liquidity_constraint": 0.03,
    "description": "Risk component weights (must sum to 1.0)"
  },

  "presets": {
    "conservative": {
      "description": "Higher costs, stricter risk limits for conservative backtesting",
      "cost_multiplier": 1.5,
      "max_risk_score": 0.50,
      "max_position_size_pct": 5.0
    },
    "aggressive": {
      "description": "Lower costs, relaxed limits for optimistic scenarios",
      "cost_multiplier": 0.75,
      "max_risk_score": 0.75,
      "max_position_size_pct": 15.0
    },
    "realistic": {
      "description": "Standard parameters matching real-world institutional trading",
      "cost_multiplier": 1.0,
      "max_risk_score": 0.65,
      "max_position_size_pct": 10.0
    }
  },

  "stop_loss_take_profit": {
    "enabled": true,
    "default_method": "atr_based",
    "description": "Stop loss and take profit calculation parameters",

    "atr_based": {
      "description": "ATR-based stops adapt to market volatility using Average True Range",
      "atr_period_days": 14,
      "atr_multiplier_stop_loss": {
        "low": 1.5,
        "medium": 2.0,
        "high": 2.5,
        "stressed": 3.0,
        "unknown": 2.0
      },
      "atr_multiplier_take_profit": {
        "low": 2.5,
        "medium": 3.0,
        "high": 3.5,
        "stressed": 4.0,
        "unknown": 3.0
      },
      "min_risk_reward_ratio": 1.5
    },

    "risk_adjusted": {
      "description": "Risk score adjusts stop loss distance (tighter stops for higher risk)",
      "base_stop_loss_pct": 2.0,
      "base_take_profit_pct": 4.0,
      "risk_multiplier_min": 0.5,
      "risk_multiplier_max": 2.0,
      "confidence_adjustment_enabled": true,
      "confidence_adjustment_factor": 0.2
    },

    "percentage_based": {
      "description": "Simple fixed percentage-based stops (fallback method)",
      "default_stop_loss_pct": 2.0,
      "default_take_profit_pct": 4.0,
      "by_horizon": {
        "1d": {"stop_loss_pct": 1.5, "take_profit_pct": 3.0},
        "5d": {"stop_loss_pct": 2.5, "take_profit_pct": 5.0},
        "20d": {"stop_loss_pct": 4.0, "take_profit_pct": 8.0}
      }
    },

    "trailing_stop": {
      "enabled": true,
      "activation_profit_pct": 1.0,
      "trail_distance_pct": 1.5,
      "description": "Trailing stop activates after reaching profit threshold"
    },

    "penny_stock_adjustments": {
      "enabled": true,
      "description": "Special handling for low-priced stocks",
      "penny_stock_multiplier": 1.5,
      "ultra_penny_multiplier": 2.0,
      "min_stop_loss_pct": 5.0,
      "max_stop_loss_pct": 15.0
    },

    "position_exit": {
      "partial_exit_enabled": false,
      "partial_exit_at_profit_pct": 2.0,
      "partial_exit_size_pct": 50.0,
      "description": "Partial position exit rules (not yet implemented)"
    }
  }
}
